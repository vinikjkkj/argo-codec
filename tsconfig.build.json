{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "outDir": "./dist/esm",
        "rootDir": "./src",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "types": []
    },
    "include": ["src/**/*"],
    "exclude": ["test", "node_modules", "dist"]
}
