{
    "name": "argo-js",
    "version": "0.1.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc",
        "test": "node --import tsx --test test/*.test.ts",
        "format": "prettier --write \"{src,test}/**/*.ts\"",
        "format:check": "prettier --check \"{src,test}/**/*.ts\""
    },
    "devDependencies": {
        "@types/node": "^25.6.0",
        "argo-graphql": "^1.1.1",
        "prettier": "^3.2.0",
        "tsx": "^4.7.0",
        "typescript": "^5.4.0"
    }
}
